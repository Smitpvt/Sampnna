# ─── Site & Frontend Configuration ──────────────────────────────────────────
# Canonical public URL, used for metadata, sitemap and Open Graph.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Backend API URL (for client-side and server-side Next.js data fetching)
NEXT_PUBLIC_API_URL="http://localhost:5000"
INTERNAL_API_URL="http://localhost:5000"

# Optional: Supabase Storage for admin-uploaded images
# NEXT_PUBLIC_SUPABASE_URL="https://[PROJECT-REF].supabase.co"

