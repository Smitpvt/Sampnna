# ─── Database (Supabase PostgreSQL) ───────────────────────────────────────────
# Supabase dashboard → Project → Connect → "ORMs" → Prisma.
#
# Runtime connection: Supavisor TRANSACTION pooler (port 6543). Required on
# Vercel/serverless so each function invocation doesn't exhaust Postgres
# connections. `pgbouncer=true` disables prepared statements, which the
# transaction pooler doesn't support.
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[DB-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"

# Migrations / seeding: SESSION pooler (port 5432) or the direct connection.
# Prisma Migrate needs a session-level connection.
DIRECT_URL="postgresql://postgres.[PROJECT-REF]:[DB-PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# ─── Site ─────────────────────────────────────────────────────────────────────
# Canonical public URL, used for metadata, sitemap and Open Graph.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ─── Optional: Supabase Storage for admin-uploaded images ─────────────────────
# Only needed once images are uploaded to a public Storage bucket. Adds the
# host to next/image's allowed remote patterns.
# NEXT_PUBLIC_SUPABASE_URL="https://[PROJECT-REF].supabase.co"
